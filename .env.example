# Copia este archivo como .env y completa los valores de tu instalación local.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=notes_db

# Orígenes permitidos por CORS (expresión regular). Por defecto: localhost en
# cualquier puerto, suficiente para `flutter run -d chrome`.
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Base de datos aislada que usan las pruebas automatizadas.
# Debe ser distinta de DB_NAME y contener "test" en el nombre.
TEST_DB_NAME=notes_test_db
